rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── invite_codes ──────────────────────────────────────────────
    // Any signed-in user must be able to READ a code (to accept an invite
    // created by someone else). Only the owner can delete their code.
    // The acceptor no longer needs to delete — the client omits the delete
    // call and relies on the owner to clean up, or the code stays inert
    // (the partnership is already claimed, so the code is consumed).
    match /invite_codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

    // Shared membership check for the partnership chat subcollection.
    // get() reads the parent doc — a constant path for list queries, so
    // listing messages passes rules without per-message uid filters.
    function isPartnershipMember(partnershipId) {
      return request.auth != null && (
        get(/databases/$(database)/documents/partnerships/$(partnershipId)).data.ownerUid == request.auth.uid
        || get(/databases/$(database)/documents/partnerships/$(partnershipId)).data.partnerUid == request.auth.uid
      );
    }

    // The task client may add/remove only the caller's own accountable UID.
    // The size and containment checks make these exact single-element deltas.
    function addsOnlyCaller(before, after) {
      return after is list && (
        (before == null
          && after.size() == 1
          && after[0] == request.auth.uid)
        || (before is list && (
          after == before
          || (!(request.auth.uid in before)
              && after.size() == before.size() + 1
              && after.hasAll(before)
              && request.auth.uid in after)
        ))
      );
    }

    function removesOnlyCaller(before, after) {
      return before is list
          && after is list
          && request.auth.uid in before
          && !(request.auth.uid in after)
          && before.size() == after.size() + 1
          && before.hasAll(after);
    }

    // The client clock supplies the exact 24-hour offset; constrain the
    // submission timestamp so future dates are rejected while offline flushes succeed.
    function hasValidReviewWindow() {
      return request.resource.data.submittedAt is timestamp
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.submittedAt
                 <= request.time + duration.value(5, 'm')
          && request.resource.data.expiresAt
                 == request.resource.data.submittedAt
                      + duration.value(24, 'h')
          && request.resource.data.expiresAt
                 > request.resource.data.submittedAt;
    }

    function hasSingleVoteAppend(uidField, voteField) {
      let beforeUids = resource.data.get(uidField, []);
      let afterUids = request.resource.data.get(uidField, null);
      let beforeVotes = resource.data.get(voteField, []);
      let afterVotes = request.resource.data.get(voteField, null);
      return beforeUids is list
          && afterUids is list
          && beforeVotes is list
          && afterVotes is list
          && beforeUids.size() == beforeVotes.size()
          && afterUids.size() == afterVotes.size()
          && !(request.auth.uid in beforeUids)
          && afterUids.size() == beforeUids.size() + 1
          && afterUids.hasAll(beforeUids)
          && request.auth.uid in afterUids
          && afterVotes.size() == beforeVotes.size() + 1
          && afterVotes.hasAll(beforeVotes)
          && afterVotes[afterVotes.size() - 1] is map
          && afterVotes[afterVotes.size() - 1].uid == request.auth.uid
          && afterVotes[afterVotes.size() - 1].timestamp is timestamp;
    }

    function isApprovalQuorumMet() {
      return request.resource.data.get('requiredApprovals', 1) is int
          && request.resource.data.get('requiredApprovals', 1) > 0
          && request.resource.data.approvalUids is list
          && request.resource.data.approvalUids.size()
                 >= request.resource.data.get('requiredApprovals', 1);
    }

    function isProofReviewer() {
      // In the creator=doer model: assigner == doer (assignedByUid ==
      // accountableUid). Two reviewer scenarios:
      // 1. Assigned reviewer: partnerUid is set → only them can review
      //    (never the assigner/doer).
      // 2. Self-review: no partnerUid assigned → the doer (assigner) can
      //    review their own proof and complete the task.
      let isAssignedReviewer = resource.data.get('partnerUid', '') is string
          && resource.data.partnerUid != ''
          && resource.data.partnerUid == request.auth.uid
          && resource.data.assignedByUid != request.auth.uid;
      let isSelfReview = (resource.data.get('partnerUid', '') == null
          || resource.data.get('partnerUid', '') == '')
          && resource.data.accountableUid == request.auth.uid;
      return isAssignedReviewer || isSelfReview;
    }

    function hasNotVotedOnProof() {
      return !(request.auth.uid
                 in resource.data.get('approvalUids', []))
          && !(request.auth.uid
                 in resource.data.get('rejectionUids', []));
    }

    function canUpdateProof() {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      let status = request.resource.data.get('status', null);
      let proofStatus = request.resource.data.get('proofStatus', null);
      let decision = request.resource.data.get('reviewDecision', null);
      return (
        // Owners start a new proof round with empty vote histories.
        ((resource.data.assignedByUid == request.auth.uid || resource.data.accountableUid == request.auth.uid)
          && resource.data.get('proofStatus', 'not_required') != 'submitted'
          && resource.data.status in ['pending', 'rejected', 'completed',
                                      'approved']
          && changes.hasOnly(['proofStatus', 'proofUrl', 'proofSubmittedAt',
                              'status', 'submittedAt', 'expiresAt',
                              'approvals', 'rejections', 'approvalUids',
                              'rejectionUids'])
          && proofStatus == 'submitted'
          && request.resource.data.approvals == []
          && request.resource.data.rejections == []
          && request.resource.data.approvalUids == []
          && request.resource.data.rejectionUids == []
          && (!changes.hasAny(['status'])
              || (status == 'pendingReview' && hasValidReviewWindow())))
        // Approval votes append one matching UID and record. Finalization
        // is part of the same vote when this update reaches quorum.
        || (resource.data.proofStatus == 'submitted'
          && isProofReviewer()
          && hasNotVotedOnProof()
          && resource.data.get('rejectionUids', []).size()
                 == resource.data.get('rejections', []).size()
          && changes.hasOnly(['approvalUids', 'approvals', 'proofReviewedAt',
                              'status', 'proofStatus', 'reviewDecision',
                              'reviewedAt', 'completedAt'])
          && hasSingleVoteAppend('approvalUids', 'approvals')
          && request.resource.data.proofReviewedAt is timestamp
          && ((status == resource.data.get('status', null)
              && proofStatus == resource.data.get('proofStatus', null)
              && decision == resource.data.get('reviewDecision', null)
              && request.resource.data.get('reviewedAt', null)
                     == resource.data.get('reviewedAt', null)
              && request.resource.data.get('completedAt', null)
                     == resource.data.get('completedAt', null))
            || (status == 'approved'
              && proofStatus == 'approved'
              && decision == 'approved'
              && request.resource.data.reviewedAt is timestamp
              && request.resource.data.completedAt is timestamp
              && isApprovalQuorumMet())))
        // Rejection remains immediate and terminal but also requires one
        // unique, matching reviewer-specific append.
        || (resource.data.proofStatus == 'submitted'
          && isProofReviewer()
          && hasNotVotedOnProof()
          && resource.data.get('approvalUids', []).size()
                 == resource.data.get('approvals', []).size()
          && changes.hasOnly(['rejectionUids', 'rejections', 'proofStatus',
                              'proofReviewComment', 'proofReviewedAt',
                              'status', 'reviewDecision', 'reviewedAt'])
          && hasSingleVoteAppend('rejectionUids', 'rejections')
          && proofStatus == 'rejected'
          && status == 'rejected'
          && decision == 'rejected'
          && request.resource.data.reviewedAt is timestamp
          && request.resource.data.proofReviewedAt is timestamp)
        // Concurrent votes may reach quorum after a caller's read. An
        // existing approver may then finalize, but cannot alter vote data.
        || (resource.data.proofStatus == 'submitted'
          && isProofReviewer()
          && request.auth.uid in resource.data.get('approvalUids', [])
          && resource.data.get('approvals', null) is list
          && resource.data.get('approvalUids', null) is list
          && resource.data.approvalUids.size()
                 == resource.data.approvals.size()
          && resource.data.get('requiredApprovals', 1) is int
          && resource.data.get('requiredApprovals', 1) > 0
          && resource.data.approvalUids.size()
                 >= resource.data.get('requiredApprovals', 1)
          && status == 'approved'
          && proofStatus == 'approved'
          && decision == 'approved'
          && request.resource.data.reviewedAt is timestamp
          && request.resource.data.completedAt is timestamp
          && changes.hasOnly(['proofStatus', 'proofReviewComment',
                              'proofReviewedAt', 'status', 'reviewDecision',
                              'reviewedAt', 'completedAt']))
      );
    }

    // ── partnerships ──────────────────────────────────────────────
    // Owner can create. Owner or accepted partner can read/delete.
    // The acceptor claims a pending partnership via an update-only
    // transaction (no pre-read required), so pending docs do NOT need
    // a blanket read rule. After the claim sets partnerUid, the normal
    // owner-or-partner read rule applies.
    match /partnerships/{partnershipId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;

      // Only established members (owner or accepted partner) can read.
      allow read: if request.auth != null
                  && (resource.data.ownerUid == request.auth.uid
                      || resource.data.partnerUid == request.auth.uid);

      allow delete: if request.auth != null
                    && (resource.data.ownerUid == request.auth.uid
                        || resource.data.partnerUid == request.auth.uid);

      allow update: if request.auth != null
                    && (
                      resource.data.ownerUid == request.auth.uid
                      || resource.data.partnerUid == request.auth.uid
                      // Claim a pending invite: caller must set partnerUid to
                      // themselves AND set status to 'accepted'. No other
                      // fields may be altered beyond acceptedAt.
                      || (resource.data.partnerUid == null
                          && request.resource.data.partnerUid == request.auth.uid
                          && request.resource.data.status == 'accepted')
                      // Legacy docs stored partnerUid as '' instead of null
                      // for "not claimed yet" — treat '' the same as null.
                      || (resource.data.partnerUid == ''
                          && request.resource.data.partnerUid == request.auth.uid
                          && request.resource.data.status == 'accepted')
                      // The invited email holder may accept or decline a still-
                      // pending invite addressed to them. Covers docs whose
                      // partnerUid points at a stale/empty uid.
                      || (resource.data.status == 'pending'
                          && resource.data.partnerEmail == request.auth.token.email
                          && (request.resource.data.status == 'accepted'
                              || request.resource.data.status == 'declined'))
                    );

      // ── messages (partner chat) ─────────────────────────────────
      // Membership comes from the parent partnership doc, so listing
      // this subcollection passes rules. The sender must stamp their
      // own uid and keep the message tied to this partnership.
      match /messages/{messageId} {
        allow read: if isPartnershipMember(partnershipId);
        allow create: if isPartnershipMember(partnershipId)
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.partnershipId == partnershipId;
        allow update: if isPartnershipMember(partnershipId)
                      && resource.data.senderUid == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['text'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0;
        allow delete: if request.auth != null
                      && isPartnershipMember(partnershipId)
                      && resource.data.senderUid == request.auth.uid;
      }
    }

    // ── public_progress ───────────────────────────────────────────
    // Owner writes their own progress. Reads are restricted to the owner and
    // to users listed in the doc's `allowedReaders` array (the owner's accepted
    // partners), rather than every signed-in user. The subcollection reuses the
    // parent doc's allowedReaders via a get() lookup.
    function isAllowedReader(uid) {
      return request.auth != null && (
        request.auth.uid == uid ||
        request.auth.uid in get(/databases/$(database)/documents/public_progress/$(uid)).data.allowedReaders
      );
    }

    match /public_progress/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || (resource.data.allowedReaders != null
                          && request.auth.uid in resource.data.allowedReaders));
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /public_progress/{uid}/days/{dateKey} {
      allow read: if isAllowedReader(uid);
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── partner_reviews ───────────────────────────────────────────
    // Any signed-in user can create a review.
    // Subject and reviewer can read. Only reviewer can delete.
    match /partner_reviews/{reviewId} {
      allow create: if request.auth != null
                    && request.resource.data.reviewerUid == request.auth.uid;
      allow read: if request.auth != null
                  && (resource.data.subjectUid == request.auth.uid
                      || resource.data.reviewerUid == request.auth.uid);
      allow delete: if request.auth != null
                    && resource.data.reviewerUid == request.auth.uid;
    }

    // ── users ─────────────────────────────────────────────────────
    // Any signed-in user can read the users collection — needed for the
    // email-based partner lookup (findUserByEmail queries by email field).
    // Only the owner can create or update their own document.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                             && request.auth.uid == uid;
    }

    // ── entitlements ───────────────────────────────────────────────
    // Premium state is written by a trusted billing/backend integration.
    // Clients may read only their own document; client writes are denied.
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ── user_data (encrypted cloud backup) ────────────────────────
    // Only the owner can read/write their own encrypted backup.
    // This collection stores AES-256-GCM ciphertext — unreadable without the key.
    match /user_data/{uid} {
      allow read, write: if request.auth != null
                          && request.auth.uid == uid;
    }

    // ── invitations ───────────────────────────────────────────────
    // Sender creates. Both sender and recipient can read.
    // Only the recipient can update (accept/reject).
    // Either party can delete (sender cancels, recipient clears).
    //
    // toUid may be null at invite time if the recipient has not yet
    // registered — in that case we fall back to matching by toEmail
    // against the verified token email.
    match /invitations/{invitationId} {
      // Any signed-in user can send an invite.
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid;

      // Sender or recipient can read.
      // Recipient may be identified by toUid OR by matching toEmail to the
      // token email (covers the case where toUid is null pre-registration).
      allow read: if request.auth != null
                  && (
                    resource.data.fromUid == request.auth.uid
                    || resource.data.toUid == request.auth.uid
                    || resource.data.toEmail == request.auth.token.email
                  );

      // Only the recipient can update (accept / reject).
      // Accepts: sets status = 'accepted' and toUid = auth.uid.
      // Rejects: sets status = 'rejected'.
      // Identified by toUid match OR by toEmail match (pre-registration).
      allow update: if request.auth != null
                    && (
                      resource.data.toUid == request.auth.uid
                      || resource.data.toEmail == request.auth.token.email
                    );

      // Sender can cancel a pending invite; either party can clean up.
      allow delete: if request.auth != null
                    && (
                      resource.data.fromUid == request.auth.uid
                      || resource.data.toUid == request.auth.uid
                      || resource.data.toEmail == request.auth.token.email
                    );
    }

   match /task_collaborators/{taskId} {
  // Read restricted to the owner and listed collaborators, not every user.
  // Uses the flat `collaboratorUids` array (owner + collaborators) that the
  // client keeps in sync, since rules cannot map over arrays of objects.
  allow read: if request.auth != null
              && (resource.data.owner.uid == request.auth.uid
                  || (resource.data.collaboratorUids != null
                      && request.auth.uid in resource.data.collaboratorUids));

  allow create: if request.auth != null
                && request.resource.data.owner.uid == request.auth.uid;

  allow update: if request.auth != null
                && resource.data.owner.uid == request.auth.uid;

  allow delete: if request.auth != null
                && resource.data.owner.uid == request.auth.uid;
}
    // ── accountability_tasks ──────────────────────────────────────
    // Read restricted to: task creator (assignedByUid), accountable user,
    // or the assigned reviewing partner (partnerUid). Only the creator can create.
    // Updates are field-level (rules_version 2): every allowed transition is
    // gated by a diff().affectedKeys() whitelist mirroring the field sets its
    // writer in accountability_service.dart uses. Ownership fields
    // (assignedByUid, accountableUid, partnerUid, accountableUserIds) are
    // immutable outside identity claim/accept, and review fields are one-shot.
    match /accountability_tasks/{taskId} {
      allow read: if request.auth != null
                  && (resource.data.assignedByUid == request.auth.uid
                      || resource.data.accountableUid == request.auth.uid
                      || resource.data.partnerUid == request.auth.uid
                      || (resource.data.accountableUserIds != null
                          && request.auth.uid in resource.data.accountableUserIds)
                      // Task addressed to my email before I had an account
                      || (resource.data.accountableEmail is string
                          && resource.data.accountableEmail == request.auth.token.email));
      allow create: if request.auth != null
                    && request.resource.data.assignedByUid == request.auth.uid
                    && request.resource.data.get('approvals', []) == []
                    && request.resource.data.get('rejections', []) == []
                    && request.resource.data.get('approvalUids', []) == []
                    && request.resource.data.get('rejectionUids', []) == [];

      // Whitelist per transition, traced to its writer(s):
      //   claim     claimTasksAssignedToMyEmail → accountableUid[+accountableUserIds]
      //   submit    submitForReview            → status, submittedAt, expiresAt
      //   review    approveTask / rejectTask   → status, reviewDecision,
      //                                            reviewComment, reviewedAt,
      //                                            completedAt
      //   expire    review_expiry_service      → status, reviewDecision, reviewedAt
      //   accept    acceptTaskRequest          → status, accountableUid,
      //                                            accountableUserIds
      //   r-accept  acceptReviewRequest        → status  (/ declineReviewRequest)
      //   decline   declineTaskRequest /
      //             cancelAccountabilityTask   → status
      //   complete  completeAccountabilityTask /
      //             uncompleteAccountabilityTask → status, completedAt
      //   p-submit  submitTaskProof /
      //             submitProofForReview       → proofStatus, proofUrl,
      //                                            proofSubmittedAt (+ submit set)
      //   p-review  reviewTaskProof / approveProof / rejectProof → approvals,
      //             rejections, proofStatus, proofReviewComment,
      //             proofReviewedAt, status, reviewDecision, reviewedAt,
      //             completedAt
      allow update: if request.auth != null && (
        canUpdateProof() ||
        // Claim: the addressed email holder fills in ONLY their own
        // identity — own uid (and self-entry in accountableUserIds);
        // assigner and address stay untouched (claimTasksAssignedToMyEmail).
        resource.data.accountableEmail is string
            && resource.data.accountableEmail == request.auth.token.email
            && request.resource.data.accountableUid == request.auth.uid
            && request.resource.data.assignedByUid == resource.data.assignedByUid
            && request.resource.data.accountableEmail == resource.data.accountableEmail
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['accountableUid', 'accountableUserIds'])
            && addsOnlyCaller(
                 resource.data.get('accountableUserIds', null),
                 request.resource.data.get('accountableUserIds', null))
        // Submit for review: the accountable doer flips pending →
        // pendingReview (submitForReview) — submission stamps only, and it
        // cannot touch review fields, so the doer can never self-approve.
        || (resource.data.status == 'pending'
            && resource.data.accountableUid == request.auth.uid
            && request.resource.data.status == 'pendingReview'
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'submittedAt', 'expiresAt'])
            && hasValidReviewWindow())
        // Review decision: partner or assigner decides an in-flight review
        // (approveTask / rejectTask). Allowed only while status is still
        // pendingReview, so a finalized review can never be rewritten.
        || ((resource.data.partnerUid == request.auth.uid
                || resource.data.assignedByUid == request.auth.uid)
            && resource.data.status == 'pendingReview'
            && (resource.data.expiresAt == null
                || request.time <= resource.data.expiresAt)
            && ((request.resource.data.status == 'approved'
                    && request.resource.data.reviewDecision == 'approved')
                || (request.resource.data.status == 'rejected'
                    && request.resource.data.reviewDecision == 'rejected'))
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'reviewDecision', 'reviewComment',
                             'reviewedAt', 'completedAt']))
        // Expire: the accountable doer may mark an OVERDUE review expired
        // (review_expiry_service) — never before expiresAt passes, so they
        // cannot dodge a live review.
        || (resource.data.accountableUid == request.auth.uid
            && resource.data.status == 'pendingReview'
            && resource.data.expiresAt != null
            && request.time > resource.data.expiresAt
            && request.resource.data.status == 'expired'
            && request.resource.data.reviewDecision == 'expired'
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'reviewDecision', 'reviewedAt']))
        // Accept a requested task (acceptTaskRequest): the addressed doer
        // claims themselves as accountable — own uid and joins
        // accountableUserIds, requested → pending; ownership untouched.
        || ((resource.data.accountableUid == request.auth.uid
                || (resource.data.accountableEmail is string
                    && resource.data.accountableEmail
                           == request.auth.token.email))
            && resource.data.status == 'requested'
            && request.resource.data.status == 'pending'
            && request.resource.data.accountableUid == request.auth.uid
            && addsOnlyCaller(
                 resource.data.get('accountableUserIds', null),
                 request.resource.data.get('accountableUserIds', null))
            && request.resource.data.assignedByUid == resource.data.assignedByUid
            && request.resource.data.accountableEmail
                   == resource.data.accountableEmail
            && (request.resource.data.get('partnerUid', null)
                    == resource.data.get('partnerUid', null)
                || ((resource.data.get('partnerUid', null) == null
                      || resource.data.get('partnerUid', null) == '')
                    && request.resource.data.partnerUid
                           == resource.data.assignedByUid))
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'accountableUid', 'accountableUserIds',
                             'partnerUid']))
        // Review request: a listed reviewer (never the assigner) accepts
        // requested → pending (acceptReviewRequest) or declines
        // requested → declined (declineReviewRequest), removing exactly
        // their own uid from accountableUserIds.
        || (resource.data.accountableUserIds != null
            && request.auth.uid in resource.data.accountableUserIds
            && resource.data.assignedByUid != request.auth.uid
            && resource.data.status == 'requested'
            && request.resource.data.assignedByUid == resource.data.assignedByUid
            && ((request.resource.data.status == 'pending'
                    && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status']))
                || (request.resource.data.status == 'declined'
                    && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'accountableUserIds'])
                    && removesOnlyCaller(
                         resource.data.get('accountableUserIds', null),
                         request.resource.data.get('accountableUserIds', null)))))
        // A doer can decline only an outstanding request. The assigner may
        // cancel only a live task; completed/review-finalized tasks are final.
        || (resource.data.status == 'requested'
            && request.resource.data.status == 'declined'
            && resource.data.accountableUid == request.auth.uid
            && request.resource.data.get('accountableUserIds', null)
                   == resource.data.get('accountableUserIds', null)
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status']))
        || (resource.data.status in ['requested', 'pending', 'pendingReview']
            && request.resource.data.status == 'declined'
            && resource.data.assignedByUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status']))
        // Self complete/uncomplete (completeAccountabilityTask /
        // uncompleteAccountabilityTask): the doer manages their own task's
        // completion — status and completedAt only.
        || (resource.data.accountableUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'completed'
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'completedAt']))
        || (resource.data.accountableUid == request.auth.uid
            && resource.data.status == 'completed'
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'completedAt']))
      );
      allow delete: if request.auth != null
                    && resource.data.assignedByUid == request.auth.uid;
    }

    // ── fcm_notifications ─────────────────────────────────────────
    // Sender writes a notification doc, but must stamp themselves as the
    // sender and prove that the recipient belongs to the referenced
    // partnership/accountability task. Only the recipient can read, update
    // (mark delivered), or delete (cleanup).
    function isNotificationParticipant() {
      let payload = request.resource.data.get('data', {});
      let taskId = payload.get('taskId', null);
      let partnershipId = payload.get('partnershipId', null);
      return (
        taskId is string
        && taskId.size() > 0
        && exists(/databases/$(database)/documents/accountability_tasks/$(taskId))
        && (
          get(/databases/$(database)/documents/accountability_tasks/$(taskId)).data.assignedByUid == request.auth.uid
          || get(/databases/$(database)/documents/accountability_tasks/$(taskId)).data.accountableUid == request.auth.uid
          || get(/databases/$(database)/documents/accountability_tasks/$(taskId)).data.partnerUid == request.auth.uid
          || (get(/databases/$(database)/documents/accountability_tasks/$(taskId)).data.accountableUserIds is list
              && request.auth.uid in get(/databases/$(database)/documents/accountability_tasks/$(taskId)).data.accountableUserIds)
        )
        && (
          request.resource.data.recipientUid == get(/databases/$(database)/documents/accountability_tasks/$(taskId)).data.assignedByUid
          || request.resource.data.recipientUid == get(/databases/$(database)/documents/accountability_tasks/$(taskId)).data.accountableUid
          || request.resource.data.recipientUid == get(/databases/$(database)/documents/accountability_tasks/$(taskId)).data.partnerUid
          || (get(/databases/$(database)/documents/accountability_tasks/$(taskId)).data.accountableUserIds is list
              && request.resource.data.recipientUid in get(/databases/$(database)/documents/accountability_tasks/$(taskId)).data.accountableUserIds)
        )
      )
      || (
        partnershipId is string
        && partnershipId.size() > 0
        && exists(/databases/$(database)/documents/partnerships/$(partnershipId))
        && (
          get(/databases/$(database)/documents/partnerships/$(partnershipId)).data.ownerUid == request.auth.uid
          || get(/databases/$(database)/documents/partnerships/$(partnershipId)).data.partnerUid == request.auth.uid
        )
        && (
          request.resource.data.recipientUid == get(/databases/$(database)/documents/partnerships/$(partnershipId)).data.ownerUid
          || request.resource.data.recipientUid == get(/databases/$(database)/documents/partnerships/$(partnershipId)).data.partnerUid
        )
      );
    }

    match /fcm_notifications/{notifId} {
      allow create: if request.auth != null
                    && request.resource.data.senderUid == request.auth.uid
                    && request.resource.data.recipientUid is string
                    && request.resource.data.recipientUid != request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.body is string
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.body.size() <= 1000
                    && request.resource.data.data is map
                    && isNotificationParticipant();
      allow read, update, delete: if request.auth != null
                                  && resource.data.recipientUid == request.auth.uid;
    }
  }
}
