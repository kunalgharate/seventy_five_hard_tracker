rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── invite_codes ──────────────────────────────────────────────
    // Any signed-in user must be able to READ a code (to accept an invite
    // created by someone else). Only the owner can delete their code.
    // The acceptor no longer needs to delete — the client omits the delete
    // call and relies on the owner to clean up, or the code stays inert
    // (the partnership is already claimed, so the code is consumed).
    match /invite_codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;
    }

    // Shared membership check for the partnership chat subcollection.
    // get() reads the parent doc — a constant path for list queries, so
    // listing messages passes rules without per-message uid filters.
    function isPartnershipMember(partnershipId) {
      return request.auth != null && (
        get(/databases/$(database)/documents/partnerships/$(partnershipId)).data.ownerUid == request.auth.uid
        || get(/databases/$(database)/documents/partnerships/$(partnershipId)).data.partnerUid == request.auth.uid
      );
    }

    // ── partnerships ──────────────────────────────────────────────
    // Owner can create. Owner or accepted partner can read/delete.
    // The acceptor claims a pending partnership via an update-only
    // transaction (no pre-read required), so pending docs do NOT need
    // a blanket read rule. After the claim sets partnerUid, the normal
    // owner-or-partner read rule applies.
    match /partnerships/{partnershipId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;

      // Only established members (owner or accepted partner) can read.
      allow read: if request.auth != null
                  && (resource.data.ownerUid == request.auth.uid
                      || resource.data.partnerUid == request.auth.uid);

      allow delete: if request.auth != null
                    && (resource.data.ownerUid == request.auth.uid
                        || resource.data.partnerUid == request.auth.uid);

      allow update: if request.auth != null
                    && (
                      resource.data.ownerUid == request.auth.uid
                      || resource.data.partnerUid == request.auth.uid
                      // Claim a pending invite: caller must set partnerUid to
                      // themselves AND set status to 'accepted'. No other
                      // fields may be altered beyond acceptedAt.
                      || (resource.data.partnerUid == null
                          && request.resource.data.partnerUid == request.auth.uid
                          && request.resource.data.status == 'accepted')
                      // Legacy docs stored partnerUid as '' instead of null
                      // for "not claimed yet" — treat '' the same as null.
                      || (resource.data.partnerUid == ''
                          && request.resource.data.partnerUid == request.auth.uid
                          && request.resource.data.status == 'accepted')
                      // The invited email holder may accept or decline a still-
                      // pending invite addressed to them. Covers docs whose
                      // partnerUid points at a stale/empty uid.
                      || (resource.data.status == 'pending'
                          && resource.data.partnerEmail == request.auth.token.email
                          && (request.resource.data.status == 'accepted'
                              || request.resource.data.status == 'declined'))
                    );

      // ── messages (partner chat) ─────────────────────────────────
      // Membership comes from the parent partnership doc, so listing
      // this subcollection passes rules. The sender must stamp their
      // own uid and keep the message tied to this partnership.
      match /messages/{messageId} {
        allow read: if isPartnershipMember(partnershipId);
        allow create: if isPartnershipMember(partnershipId)
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.partnershipId == partnershipId;
        allow update: if isPartnershipMember(partnershipId);
        allow delete: if request.auth != null
                      && resource.data.senderUid == request.auth.uid;
      }
    }

    // ── public_progress ───────────────────────────────────────────
    // Owner writes their own progress. Reads are restricted to the owner and
    // to users listed in the doc's `allowedReaders` array (the owner's accepted
    // partners), rather than every signed-in user. The subcollection reuses the
    // parent doc's allowedReaders via a get() lookup.
    function isAllowedReader(uid) {
      return request.auth != null && (
        request.auth.uid == uid ||
        request.auth.uid in get(/databases/$(database)/documents/public_progress/$(uid)).data.allowedReaders
      );
    }

    match /public_progress/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || (resource.data.allowedReaders != null
                          && request.auth.uid in resource.data.allowedReaders));
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /public_progress/{uid}/days/{dateKey} {
      allow read: if isAllowedReader(uid);
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── partner_reviews ───────────────────────────────────────────
    // Any signed-in user can create a review.
    // Subject and reviewer can read. Only reviewer can delete.
    match /partner_reviews/{reviewId} {
      allow create: if request.auth != null
                    && request.resource.data.reviewerUid == request.auth.uid;
      allow read: if request.auth != null
                  && (resource.data.subjectUid == request.auth.uid
                      || resource.data.reviewerUid == request.auth.uid);
      allow delete: if request.auth != null
                    && resource.data.reviewerUid == request.auth.uid;
    }

    // ── users ─────────────────────────────────────────────────────
    // Any signed-in user can read the users collection — needed for the
    // email-based partner lookup (findUserByEmail queries by email field).
    // Only the owner can create or update their own document.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                             && request.auth.uid == uid;
    }

    // ── user_data (encrypted cloud backup) ────────────────────────
    // Only the owner can read/write their own encrypted backup.
    // This collection stores AES-256-GCM ciphertext — unreadable without the key.
    match /user_data/{uid} {
      allow read, write: if request.auth != null
                          && request.auth.uid == uid;
    }

    // ── invitations ───────────────────────────────────────────────
    // Sender creates. Both sender and recipient can read.
    // Only the recipient can update (accept/reject).
    // Either party can delete (sender cancels, recipient clears).
    //
    // toUid may be null at invite time if the recipient has not yet
    // registered — in that case we fall back to matching by toEmail
    // against the verified token email.
    match /invitations/{invitationId} {
      // Any signed-in user can send an invite.
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid;

      // Sender or recipient can read.
      // Recipient may be identified by toUid OR by matching toEmail to the
      // token email (covers the case where toUid is null pre-registration).
      allow read: if request.auth != null
                  && (
                    resource.data.fromUid == request.auth.uid
                    || resource.data.toUid == request.auth.uid
                    || resource.data.toEmail == request.auth.token.email
                  );

      // Only the recipient can update (accept / reject).
      // Accepts: sets status = 'accepted' and toUid = auth.uid.
      // Rejects: sets status = 'rejected'.
      // Identified by toUid match OR by toEmail match (pre-registration).
      allow update: if request.auth != null
                    && (
                      resource.data.toUid == request.auth.uid
                      || resource.data.toEmail == request.auth.token.email
                    );

      // Sender can cancel a pending invite; either party can clean up.
      allow delete: if request.auth != null
                    && (
                      resource.data.fromUid == request.auth.uid
                      || resource.data.toUid == request.auth.uid
                      || resource.data.toEmail == request.auth.token.email
                    );
    }

   match /task_collaborators/{taskId} {
  // Read restricted to the owner and listed collaborators, not every user.
  // Uses the flat `collaboratorUids` array (owner + collaborators) that the
  // client keeps in sync, since rules cannot map over arrays of objects.
  allow read: if request.auth != null
              && (resource.data.owner.uid == request.auth.uid
                  || (resource.data.collaboratorUids != null
                      && request.auth.uid in resource.data.collaboratorUids));

  allow create: if request.auth != null
                && request.resource.data.owner.uid == request.auth.uid;

  allow update: if request.auth != null
                && resource.data.owner.uid == request.auth.uid;

  allow delete: if request.auth != null
                && resource.data.owner.uid == request.auth.uid;
}
    // ── accountability_tasks ──────────────────────────────────────
    // Read restricted to: task creator (assignedByUid), accountable user,
    // or the assigned reviewing partner (partnerUid). Only the creator can create.
    // Updates are field-level (rules_version 2): every allowed transition is
    // gated by a diff().affectedKeys() whitelist mirroring the field sets its
    // writer in accountability_service.dart uses. Ownership fields
    // (assignedByUid, accountableUid, partnerUid, accountableUserIds) are
    // immutable outside identity claim/accept, and review fields are one-shot.
    match /accountability_tasks/{taskId} {
      allow read: if request.auth != null
                  && (resource.data.assignedByUid == request.auth.uid
                      || resource.data.accountableUid == request.auth.uid
                      || resource.data.partnerUid == request.auth.uid
                      || (resource.data.accountableUserIds != null
                          && request.auth.uid in resource.data.accountableUserIds)
                      // Task addressed to my email before I had an account
                      || (resource.data.accountableEmail is string
                          && resource.data.accountableEmail == request.auth.token.email));
      allow create: if request.auth != null
                    && request.resource.data.assignedByUid == request.auth.uid;

      // Whitelist per transition, traced to its writer(s):
      //   claim     claimTasksAssignedToMyEmail → accountableUid[+accountableUserIds]
      //   submit    submitForReview            → status, submittedAt, expiresAt
      //   review    approveTask / rejectTask   → status, reviewDecision,
      //                                            reviewComment, reviewedAt,
      //                                            completedAt
      //   expire    review_expiry_service      → status, reviewDecision, reviewedAt
      //   accept    acceptTaskRequest          → status, accountableUid,
      //                                            accountableUserIds
      //   r-accept  acceptReviewRequest        → status  (/ declineReviewRequest)
      //   decline   declineTaskRequest /
      //             cancelAccountabilityTask   → status
      //   complete  completeAccountabilityTask /
      //             uncompleteAccountabilityTask → status, completedAt
      //   p-submit  submitTaskProof /
      //             submitProofForReview       → proofStatus, proofUrl,
      //                                            proofSubmittedAt (+ submit set)
      //   p-review  reviewTaskProof / approveProof / rejectProof → approvals,
      //             rejections, proofStatus, proofReviewComment,
      //             proofReviewedAt, status, reviewDecision, reviewedAt,
      //             completedAt
      allow update: if request.auth != null && (
        // Claim: the addressed email holder fills in ONLY their own
        // identity — own uid (and self-entry in accountableUserIds);
        // assigner and address stay untouched (claimTasksAssignedToMyEmail).
        (resource.data.accountableEmail is string
            && resource.data.accountableEmail == request.auth.token.email
            && request.resource.data.accountableUid == request.auth.uid
            && request.resource.data.assignedByUid == resource.data.assignedByUid
            && request.resource.data.accountableEmail == resource.data.accountableEmail
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['accountableUid', 'accountableUserIds'])
            && (!request.resource.data.diff(resource.data).affectedKeys()
                     .hasAny(['accountableUserIds'])
                || request.auth.uid in request.resource.data.accountableUserIds))
        // Submit for review: the accountable doer flips pending →
        // pendingReview (submitForReview) — submission stamps only, and it
        // cannot touch review fields, so the doer can never self-approve.
        || (resource.data.status == 'pending'
            && resource.data.accountableUid == request.auth.uid
            && request.resource.data.status == 'pendingReview'
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'submittedAt', 'expiresAt']))
        // Review decision: partner or assigner decides an in-flight review
        // (approveTask / rejectTask). Allowed only while status is still
        // pendingReview, so a finalized review can never be rewritten.
        || ((resource.data.partnerUid == request.auth.uid
                || resource.data.assignedByUid == request.auth.uid)
            && resource.data.status == 'pendingReview'
            && (request.resource.data.status == 'approved'
                || request.resource.data.status == 'rejected')
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'reviewDecision', 'reviewComment',
                             'reviewedAt', 'completedAt']))
        // Expire: the accountable doer may mark an OVERDUE review expired
        // (review_expiry_service) — never before expiresAt passes, so they
        // cannot dodge a live review.
        || (resource.data.accountableUid == request.auth.uid
            && resource.data.status == 'pendingReview'
            && resource.data.expiresAt != null
            && request.time > resource.data.expiresAt
            && request.resource.data.status == 'expired'
            && request.resource.data.reviewDecision == 'expired'
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'reviewDecision', 'reviewedAt']))
        // Accept a requested task (acceptTaskRequest): the addressed doer
        // claims themselves as accountable — own uid and joins
        // accountableUserIds, requested → pending; ownership untouched.
        || ((resource.data.accountableUid == request.auth.uid
                || (resource.data.accountableEmail is string
                    && resource.data.accountableEmail
                           == request.auth.token.email))
            && resource.data.status == 'requested'
            && request.resource.data.status == 'pending'
            && request.resource.data.accountableUid == request.auth.uid
            && request.auth.uid in request.resource.data.accountableUserIds
            && request.resource.data.assignedByUid == resource.data.assignedByUid
            && request.resource.data.accountableEmail
                   == resource.data.accountableEmail
            && request.resource.data.partnerUid == resource.data.partnerUid
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'accountableUid', 'accountableUserIds']))
        // Review request: a listed reviewer (never the assigner) accepts
        // requested → pending (acceptReviewRequest) or declines
        // requested → declined (declineReviewRequest), removing exactly
        // their own uid from accountableUserIds.
        || (resource.data.accountableUserIds != null
            && request.auth.uid in resource.data.accountableUserIds
            && resource.data.assignedByUid != request.auth.uid
            && resource.data.status == 'requested'
            && request.resource.data.assignedByUid == resource.data.assignedByUid
            && ((request.resource.data.status == 'pending'
                    && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status']))
                || (request.resource.data.status == 'declined'
                    && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'accountableUserIds'])
                    && !(request.auth.uid
                             in request.resource.data.accountableUserIds)
                    && request.resource.data.accountableUserIds.size()
                           == resource.data.accountableUserIds.size() - 1)))
        // Decline / cancel (declineTaskRequest / cancelAccountabilityTask):
        // the doer declines their request, the assigner cancels theirs —
        // status only.
        || (request.resource.data.status == 'declined'
            && (resource.data.accountableUid == request.auth.uid
                || resource.data.assignedByUid == request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status']))
        // Self complete/uncomplete (completeAccountabilityTask /
        // uncompleteAccountabilityTask): the doer manages their own task's
        // completion — status and completedAt only.
        || (resource.data.accountableUid == request.auth.uid
            && (request.resource.data.status == 'completed'
                || request.resource.data.status == 'pending')
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'completedAt']))
        // Proof submission: the owner (assignedByUid) attaches their proof
        // (submitTaskProof / submitProofForReview); status, when touched,
        // may only go to pendingReview.
        || (resource.data.assignedByUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['proofStatus', 'proofUrl', 'proofSubmittedAt',
                             'status', 'submittedAt', 'expiresAt'])
            && (!request.resource.data.diff(resource.data).affectedKeys()
                     .hasAny(['proofStatus'])
                || request.resource.data.proofStatus == 'submitted')
            && (!request.resource.data.diff(resource.data).affectedKeys()
                     .hasAny(['status'])
                || request.resource.data.status == 'pendingReview'))
        // Proof review: reviewers vote and finalize (reviewTaskProof /
        // approveProof / rejectProof) — partner or accountable users, NEVER
        // the owner; only while proofStatus is still 'submitted', which
        // freezes the proof once a final decision is written.
        || (resource.data.proofStatus == 'submitted'
            && resource.data.assignedByUid != request.auth.uid
            && (resource.data.partnerUid == request.auth.uid
                || resource.data.accountableUid == request.auth.uid
                || (resource.data.accountableUserIds != null
                    && request.auth.uid in resource.data.accountableUserIds))
            && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['approvals', 'rejections', 'proofStatus',
                             'proofReviewComment', 'proofReviewedAt',
                             'status', 'reviewDecision', 'reviewedAt',
                             'completedAt'])
            && (!request.resource.data.diff(resource.data).affectedKeys()
                     .hasAny(['proofStatus'])
                || (request.resource.data.proofStatus == 'approved'
                    || request.resource.data.proofStatus == 'rejected'))
            && (!request.resource.data.diff(resource.data).affectedKeys()
                     .hasAny(['status'])
                || (request.resource.data.status == 'approved'
                    || request.resource.data.status == 'rejected'
                    || request.resource.data.status == 'completed'
                    || request.resource.data.status == 'pending'))
            && (!request.resource.data.diff(resource.data).affectedKeys()
                     .hasAny(['reviewDecision'])
                || (request.resource.data.reviewDecision == 'approved'
                    || request.resource.data.reviewDecision
                           == 'rejected'))));
      allow delete: if request.auth != null
                    && resource.data.assignedByUid == request.auth.uid;
    }

    // ── fcm_notifications ─────────────────────────────────────────
    // Sender writes a notification doc, but must stamp themselves as the
    // sender (prevents spoofing another user as the sender). Only the
    // recipient can read, update (mark delivered), or delete (cleanup).
    match /fcm_notifications/{notifId} {
      allow create: if request.auth != null
                    && request.resource.data.senderUid == request.auth.uid;
      allow read, update, delete: if request.auth != null
                                  && resource.data.recipientUid == request.auth.uid;
    }
  }
}
